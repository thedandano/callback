{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "callback": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--python",
        ">=3.12",
        "--no-dev",
        "--project",
        "${PLUGIN_ROOT}",
        "callback",
        "serve"
      ]
    }
  }
}
